{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-tps": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "tiktoken>=0.8,<1",
        "python",
        "${PLUGIN_ROOT}/server.py",
        "mcp"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
